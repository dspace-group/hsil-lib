<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Minimal valid CycloneDDS configuration used by the HSIL DDS integration
    tests.  Restricts discovery and transport to the loopback interface so
    that tests run without a physical network and do not disturb other
    participants on the LAN.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface address="127.0.0.1" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <EnableMulticastLoopback>true</EnableMulticastLoopback>
    </General>
    <Tracing>
      <Verbosity>warning</Verbosity>
    </Tracing>
  </Domain>
</CycloneDDS>
